{
  "name": "discordia",
  "productName": "Discordia",
  "version": "1.1.1",
  "description": "Chat de voz e compartilhamento de tela entre amigos",
  "author": "Felipe",
  "homepage": "https://github.com/felipeosouza06/app_discord2",
  "main": "main.js",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "vendor": "mkdir -p renderer/vendor/noise/rnnoise && cd node_modules/@sapphi-red/web-noise-suppressor/dist && cp index.js rnnoise.wasm rnnoise_simd.wasm ../../../../renderer/vendor/noise/ && cp rnnoise/workletProcessor.js ../../../../renderer/vendor/noise/rnnoise/",
    "release": "electron-builder --win --linux --publish always",
    "dist:deb": "electron-builder --linux deb"
  },
  "build": {
    "appId": "com.felipe.discordia",
    "productName": "Discordia",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Discordia-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "artifactName": "Discordia-${version}.${ext}",
      "maintainer": "Felipe Oliveira Souza <felipeosouza06@gmail.com>",
      "synopsis": "Voz, chat e tela compartilhada com os amigos"
    },
    "mac": {
      "target": "dmg",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O Discórdia usa o microfone para o chat de voz."
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "felipeosouza06",
        "repo": "app_discord2",
        "releaseType": "release"
      }
    ],
    "deb": {
      "artifactName": "discordia_${version}_${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
